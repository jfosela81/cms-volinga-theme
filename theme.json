{
  "$schema": "https://schemas.wp.org/trunk/theme.json",
  "version": 2,
  "settings": {
    "color": {
      "palette": [
        { "slug": "background", "color": "#F8FAFC", "name": "Background" },
        { "slug": "surface",    "color": "#f5f5f5", "name": "Surface" },
        { "slug": "border",     "color": "#e4e4e4", "name": "Border" },
        { "slug": "text",       "color": "#111111", "name": "Text" },
        { "slug": "muted",      "color": "#666666", "name": "Muted" },
        { "slug": "accent",     "color": "#5b4eff", "name": "Accent" }
      ],
      "custom": false,
      "customDuotone": false,
      "customGradient": false,
      "defaultPalette": false,
      "defaultGradients": false
    },
    "typography": {
      "fontFamilies": [
        {
          "fontFamily": "'Rethink Sans', system-ui, sans-serif",
          "slug": "rethink-sans",
          "name": "Rethink Sans"
        },
        {
          "fontFamily": "'JetBrains Mono', monospace",
          "slug": "mono",
          "name": "Monospace"
        }
      ],
      "fontSizes": [
        { "slug": "xs",   "size": "0.8125rem", "name": "XS — 13px" },
        { "slug": "sm",   "size": "0.9375rem", "name": "SM — 15px" },
        { "slug": "base", "size": "1.0625rem", "name": "Base — 17px" },
        { "slug": "md",   "size": "1.125rem",  "name": "MD — 18px" },
        { "slug": "lg",   "size": "1.375rem",  "name": "LG — 22px" },
        { "slug": "xl",   "size": "1.75rem",   "name": "XL — 28px" },
        { "slug": "2xl",  "size": "2.25rem",   "name": "2XL — 36px" },
        { "slug": "3xl",  "size": "3rem",      "name": "3XL — 48px" }
      ],
      "customFontSize": false,
      "dropCap": false,
      "lineHeight": false,
      "fontStyle": false,
      "fontWeight": false,
      "letterSpacing": false,
      "textDecoration": false,
      "textTransform": false
    },
    "layout": {
      "contentSize": "760px",
      "wideSize": "1248px"
    },
    "spacing": {
      "blockGap": true,
      "padding": true,
      "margin": true,
      "units": [ "px", "rem", "%" ]
    },
    "border": {
      "color": false,
      "radius": false,
      "style": false,
      "width": false
    }
  },
  "styles": {
    "color": {
      "background": "#F8FAFC",
      "text": "#111111"
    },
    "typography": {
      "fontFamily": "var(--wp--preset--font-family--rethink-sans)",
      "fontSize": "var(--wp--preset--font-size--base)",
      "lineHeight": "1.7"
    },
    "elements": {
      "h1": {
        "typography": {
          "fontSize": "clamp(2rem, 4vw, var(--wp--preset--font-size--3xl))",
          "fontWeight": "700",
          "lineHeight": "1.15",
          "letterSpacing": "-0.025em"
        }
      },
      "h2": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--xl)",
          "fontWeight": "700",
          "lineHeight": "1.25",
          "letterSpacing": "-0.015em"
        }
      },
      "h3": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--lg)",
          "fontWeight": "600",
          "lineHeight": "1.3"
        }
      },
      "h4": {
        "typography": {
          "fontSize": "var(--wp--preset--font-size--md)",
          "fontWeight": "600",
          "lineHeight": "1.4"
        }
      },
      "link": {
        "color": { "text": "#5b4eff" },
        ":hover": { "color": { "text": "#7c6fff" } }
      }
    },
    "blocks": {
      "core/paragraph": {
        "spacing": {
          "margin": { "bottom": "1.35rem" }
        }
      },
      "core/heading": {
        "spacing": {
          "margin": { "top": "2.5rem", "bottom": "0.75rem" }
        }
      },
      "core/quote": {
        "color": {
          "text": "#0E1A2A"
        },
        "spacing": {
          "padding": {
            "top": "1.5rem",
            "bottom": "1.5rem",
            "left": "1.75rem",
            "right": "1.75rem"
          },
          "margin": { "top": "2.5rem", "bottom": "2.5rem" }
        }
      },
      "core/image": {
        "spacing": {
          "margin": { "top": "2rem", "bottom": "2rem" }
        }
      },
      "core/list": {
        "spacing": {
          "margin": { "bottom": "1.35rem" }
        }
      },
      "core/separator": {
        "color": { "text": "#e4e4e4" },
        "spacing": {
          "margin": { "top": "2.5rem", "bottom": "2.5rem" }
        }
      }
    }
  }
}
